{
  "name": "Livechart Episode Finder",
  "description": "Nyaa searches for LiveChart charts, lists, schedules, anime pages and release reminders",
  "manifest_version": 3,
  "version": "0.3.2",
  "content_scripts": [
    {
      "matches": [
        "*://*.livechart.me/*"
      ],
      "run_at": "document_end",
      "js": [
        "scripts/search.js",
        "scripts/content.js"
      ],
      "css": [
        "scripts/content.css"
      ]
    }
  ],
  "permissions": [
    "storage"
  ]
}
